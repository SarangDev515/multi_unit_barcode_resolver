<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="multi_unit_barcode_scan_wizard_form" model="ir.ui.view">
        <field name="name">multi.unit.barcode.scan.wizard.form</field>
        <field name="model">multi.unit.barcode.scan.wizard</field>
        <field name="arch" type="xml">
            <form string="Scan Packaging Barcode">
                <group>
                    <field name="picking_id"/>
                    <field name="barcode" autofocus="autofocus" placeholder="Scan barcode"/>
                    <field name="scan_quantity"/>
                </group>
                <group invisible="not last_result">
                    <field name="last_result_type" widget="badge"/>
                    <field name="last_result" nolabel="1" readonly="1"/>
                </group>
                <footer>
                    <button name="action_scan" type="object" string="Scan" class="oe_highlight"/>
                    <button name="action_close" type="object" string="Close" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
