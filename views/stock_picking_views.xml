<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_multi_unit_barcode" model="ir.ui.view">
        <field name="name">stock.picking.form.multi.unit.barcode</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_open_multi_unit_barcode_scan_wizard"
                        type="object"
                        string="Scan Package Barcode"
                        class="oe_highlight"
                        icon="fa-barcode"
                        invisible="state in ('done', 'cancel')"/>
            </xpath>
            <xpath expr="//sheet" position="inside">
                <div class="alert alert-warning mt-2"
                     role="alert"
                     invisible="multi_unit_scan_status not in ('partial', 'discrepancy')">
                    <strong>Multi-unit barcode scan requires attention.</strong>
                    <field name="multi_unit_discrepancy_message" nolabel="1" readonly="1"/>
                </div>
                <group string="Multi-Unit Scan Summary" invisible="multi_unit_scan_count == 0">
                    <field name="multi_unit_scan_status" widget="badge"/>
                    <field name="multi_unit_scan_count"/>
                    <field name="multi_unit_scanned_quantity"/>
                </group>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page name="multi_unit_barcode_scans" string="Packaging Scans">
                    <field name="multi_unit_scan_ids" readonly="1">
                        <list create="0" edit="0" delete="0">
                            <field name="scanned_at"/>
                            <field name="barcode"/>
                            <field name="product_id"/>
                            <field name="packaging_level"/>
                            <field name="package_count"/>
                            <field name="scanned_quantity"/>
                            <field name="status" widget="badge"/>
                            <field name="scanned_by"/>
                            <field name="message" optional="hide"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
